+/* udvt_background.c -- helper functions for UDVT dynamic beta and c_effective */
+#include "background.h"
+#include <math.h>
+
+/* Default parameters (expose via input file if desired) */
+double udvt_beta_early = 0.0038;
+double udvt_beta_late  = 2.9e-33;
+double udvt_a_c        = 1e-3;
+double udvt_delta_a    = 3e-4;
+double udvt_c0         = 2.99792458e5; /* km/s in CLASS units */
+int    udvt_enable     = 0; /* 0: disabled (LCDM), 1: enabled */
+
+/* prototypes (declare in include/background.h) */
+double beta_effective(double a);
+double c_effective(double a);
+double gw_effective(double a, double gamma);
+
+double beta_effective(double a) {
+  double arg = (a - udvt_a_c) / udvt_delta_a;
+  double sigmoid = 1.0 / (1.0 + exp(arg));
+  return udvt_beta_late + (udvt_beta_early - udvt_beta_late) * sigmoid;
+}
+
+double c_effective(double a) {
+  if (!udvt_enable) return udvt_c0;
+  double b = beta_effective(a);
+  double loga = log(a > 0 ? a : 1e-30);
+  double a_pow = exp(-b * loga);
+  return udvt_c0 * a_pow;
+}
+
